# Copy to deploy/.env and edit. deploy/.env is git-ignored — never commit real secrets.
# Consumed by deploy/docker-compose.yml (variable substitution) and passed to the
# backend/worker containers.

# --- build metadata (optional) ------------------------------------------
# Baked into the backend image, surfaced by GET /meta/versions.
#   GIT_SHA=$(git rev-parse --short HEAD)
GIT_SHA=

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=analytical
POSTGRES_PASSWORD=analytical
POSTGRES_DB=analytical

# --- backend / worker (ANALYTICAL_* — pydantic-settings) ------------------
ANALYTICAL_ACTIVE_PROVIDER=stub            # stub | upstox
ANALYTICAL_RUN_WORKER_IN_PROCESS=false     # true = backend runs the scheduler; false = use the `worker` service
ANALYTICAL_LOG_JSON=true
ANALYTICAL_LOG_LEVEL=INFO
ANALYTICAL_CYCLE_INTERVAL_SECONDS=180
ANALYTICAL_SCHEDULER_SESSION_ONLY=true     # false = tick around the clock (dev)

# --- streaming (Upstox Market Data Feed v3 WebSocket; forming M1 + live OI) --
ANALYTICAL_STREAM_ENABLED=false            # true + `--profile streamer` (or `analytical-worker stream`)
ANALYTICAL_STREAM_MODE=full                # ltpc | full | option_greeks | full_d30
ANALYTICAL_RUN_STREAM_IN_PROCESS=false     # true = backend process runs the streamer thread

# --- API auth (optional) --------------------------------------------------
# If set, /api/v1 requires  Authorization: Bearer <token>
ANALYTICAL_LOCAL_API_TOKEN=

# --- Upstox (only when ANALYTICAL_ACTIVE_PROVIDER=upstox) ----------------
# Daily manual token; expires ~03:30 IST. Never commit a real value.
# Get one with:  python -m app.providers.upstox.cli login
ANALYTICAL_UPSTOX_ACCESS_TOKEN=
# App credentials from developer.upstox.com > My Apps — used only by `login`.
ANALYTICAL_UPSTOX_API_KEY=
ANALYTICAL_UPSTOX_API_SECRET=
ANALYTICAL_UPSTOX_REDIRECT_URI=http://localhost
