# Base URL for the Analytical API. In dev, leave unset to use the Vite proxy (/api -> backend).
VITE_API_BASE_URL=
# Optional bearer token when the backend has LOCAL_API_TOKEN set.
VITE_LOCAL_API_TOKEN=
# Dev-only: where the Vite proxy forwards /api (default http://localhost:8000).
VITE_API_TARGET=http://localhost:8000
